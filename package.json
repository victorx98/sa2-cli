{
  "name": "sa2-cli",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/core",
    "packages/cli"
  ],
  "scripts": {
    "build": "tsc -b packages/core packages/cli",
    "openapi:generate": "openapi-typescript contracts/openapi.json -o packages/core/src/api/generated/types.ts",
    "sa2": "node packages/cli/dist/cli.js",
    "test": "npm run build && node --test tests/cli.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "openapi-typescript": "^7.0.0",
    "typescript": "~5.9.3"
  }
}
